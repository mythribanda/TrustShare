# ==============================================================================
# TrustShare Environment Configuration Example
# ==============================================================================

# Environment mode: "development", "test", or "production"
APP_ENV=development

# PostgreSQL Database Configuration
POSTGRES_DB=trustshare
POSTGRES_USER=trustshare
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql+psycopg://trustshare:your_secure_postgres_password_here@postgres:5432/trustshare

# MongoDB Configuration
MONGO_URL=mongodb://mongo:27017
MONGO_DB=trustshare

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security & JWT Configuration
# MUST be at least 32 characters long. Fail-fast validation enforced across ALL environments.
# Generate via: openssl rand -hex 32
JWT_SECRET=generate_and_place_a_32_plus_char_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key Encryption Key (KEK) Configuration
# Format: JSON mapping of version string to base64-encoded 32-byte key.
# Generate a new 32-byte base64 key via:
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Non-production test fixture KEK provided below:
KEK_KEYS={"1":"MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="}
KEK_CURRENT_VERSION=1

# File Storage & Limits
MAX_UPLOAD_MB=10
STORAGE_DIR=

# S3 / MinIO Object Storage Configuration (Milestone 2 foundation)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=trustshare
S3_REGION=us-east-1

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
