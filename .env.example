POSTGRES_DB=trustshare
POSTGRES_USER=trustshare
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://trustshare:change-this-local-password@postgres:5432/trustshare
MONGO_URL=mongodb://mongo:27017
MONGO_DB=trustshare
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=10
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=replace-with-base64-encoded-32-byte-key

USER_STORAGE_QUOTA_MB=100
STORAGE_PROVIDER=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
# For multiple master-key versions use MASTER_KEYS=1:BASE64_OLD_KEY,2:BASE64_NEW_KEY
# ACTIVE_MASTER_KEY_VERSION=1
