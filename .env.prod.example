# ==============================================================================
# TrustShare Production Environment Configuration (.env.prod)
# Copy to .env on your EC2 instance and fill in real values. Never commit .env.
# ==============================================================================

# Public domain name for your instance (e.g. my-trustshare.duckdns.org)
# Caddy uses this to obtain an automated Let's Encrypt TLS certificate.
DOMAIN=your-domain.duckdns.org

# Database Credentials
POSTGRES_USER=trustshare
POSTGRES_PASSWORD=generate-strong-password-here
POSTGRES_DB=trustshare

MONGO_USER=trustshare
MONGO_PASSWORD=generate-strong-password-here

REDIS_PASSWORD=generate-strong-password-here

# Authentication Secrets
# Signs login tokens. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-random-string-at-least-32-chars

# Encrypts MFA secrets at rest. Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MFA_ENCRYPTION_KEY=generate-32-byte-fernet-key

# Production Cookie Security (enforces HTTPS-only cookies)
COOKIE_SECURE=true

# Application URLs (Uses the DOMAIN configured above)
FRONTEND_URL=https://${DOMAIN}
REQUIRE_EMAIL_VERIFICATION=false

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://${DOMAIN}/api/auth/google/callback

# Optional SMTP Email Delivery (e.g., Gmail App Password)
SMTP_USER=
SMTP_PASSWORD=

# File Encryption Master Keys (AES-256 Envelope Encryption)
# Generate one with: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEYS=1:generate-32-random-bytes-in-base64
ACTIVE_MASTER_KEY_VERSION=1

# AWS S3 Storage Provider Configuration
STORAGE_PROVIDER=s3
# Leave S3_ENDPOINT_URL empty when using real AWS S3:
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=your-unique-trustshare-bucket-name
S3_ACCESS_KEY_ID=your-aws-iam-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-iam-secret-access-key

# RustFS (local only, unused in prod, kept for compose schema compatibility)
RUSTFS_ACCESS_KEY=trustshare
RUSTFS_SECRET_KEY=unused-in-prod-placeholder

# Suspicious Activity Detection Rules
DETECT_FAILED_LOGINS_LIMIT=5
DETECT_FAILED_LOGINS_MINUTES=10
DETECT_UNAUTHORIZED_LIMIT=4
DETECT_UNAUTHORIZED_MINUTES=10
DETECT_DOWNLOADS_LIMIT=20
DETECT_DOWNLOADS_MINUTES=5
DETECT_EXPIRED_LINK_LIMIT=2
DETECT_EXPIRED_LINK_MINUTES=10
DETECT_REVOKED_LINK_LIMIT=2
DETECT_REVOKED_LINK_MINUTES=10

# Notification Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
LINK_REMINDER_HOURS=24
DOWNLOAD_NOTICE_COOLDOWN_MINUTES=10
ADMIN_ALERT_EMAIL_COOLDOWN_MINUTES=15
SSE_HEARTBEAT_SECONDS=25
SSE_MAX_SECONDS=3600
